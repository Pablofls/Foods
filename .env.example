# Copia este archivo a .env.local y pega tus credenciales de Supabase.
# (Settings → API en tu proyecto de Supabase)
#
# Si dejas estas variables vacías, la app funciona igual usando el
# almacenamiento del navegador (localStorage) — útil para probar antes
# de conectar Supabase. Para que los datos se compartan entre el teléfono
# y la computadora, hay que llenarlas.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
